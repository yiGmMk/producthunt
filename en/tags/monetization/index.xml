    &gt;httpx-oauth&lt;/a&gt;, &lt;a class=&#34;link&#34; href=&#34;https://github.com/pallets/jinja&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;jinja&lt;/a&gt;, &lt;a class=&#34;link&#34; href=&#34;https://github.com/pallets-eco/blinker&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;blinker&lt;/a&gt;, &lt;a class=&#34;link&#34; href=&#34;https://github.com/jpadilla/pyjwt&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
