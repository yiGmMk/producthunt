					&lt;td style=&#34;text-align: center&#34;&gt;—&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;—&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;—&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;Inherits Chrome&amp;rsquo;s data&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;✓&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;—&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;—&lt;/td&gt;
