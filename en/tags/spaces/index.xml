					&lt;td style=&#34;text-align: center&#34;&gt;—&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;Compressed semantic input&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;✓&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;—&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;✓&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;—&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;—&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;Controllable by external agents&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;✓&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;✓&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;✓&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;—&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;—&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;Data stored locally&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;✓&lt;/td&gt;
					&lt;td style=&#34;text-align: center&#34;&gt;✓&lt;/td&gt;
