        &lt;/a&gt;
      &lt;/td&gt;
      &lt;td align=&#34;center&#34; valign=&#34;middle&#34;&gt;
        &lt;a href=&#34;http://github.crmeb.net/u/Element?from=element-plus&#34; target=&#34;_blank&#34;&gt;
          &lt;img width=&#34;150px&#34; src=&#34;https://github.com/user-attachments/assets/18079452-986c-4c6e-84ec-fb6175c26567&#34;&gt;
