          &lt;img width=&#34;150px&#34; src=&#34;https://github.com/element-plus/element-plus/assets/82012629/9ca4269c-7545-4463-9bdc-8e5a1fbd0b08&#34;&gt;
        &lt;/a&gt;
      &lt;/td&gt;
