        &lt;a href=&#34;https://doc.buildadmin.com/?from=element-plus&#34; target=&#34;_blank&#34;&gt;
          &lt;img width=&#34;130px&#34; src=&#34;https://user-images.githubusercontent.com/17680888/173179536-30e35fd1-cd5a-482a-bc41-9d5f0aa66fd4.png&#34;&gt;
        &lt;/a&gt;
      &lt;/td&gt;
