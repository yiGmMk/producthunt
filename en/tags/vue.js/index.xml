          &lt;img width=&#34;150px&#34; src=&#34;https://github.com/element-plus/element-plus/assets/17680888/6a044d82-c393-48ab-90b8-de0d3aad1624&#34;&gt;
        &lt;/a&gt;
      &lt;/td&gt;
      &lt;td align=&#34;center&#34; valign=&#34;middle&#34;&gt;
