			&lt;tr&gt;
					&lt;th&gt;Exporter&lt;/th&gt;
					&lt;th style=&#34;text-align: center&#34;&gt;Logs&lt;/th&gt;
					&lt;th style=&#34;text-align: center&#34;&gt;Metrics&lt;/th&gt;
					&lt;th style=&#34;text-align: center&#34;&gt;Traces&lt;/th&gt;
