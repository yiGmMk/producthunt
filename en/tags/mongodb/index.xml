					&lt;td&gt;Jupyter notebooks examples for RAG, agentic applications, evaluations etc.&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;a class=&#34;link&#34; href=&#34;apps/README.md&#34; &gt;&lt;code&gt;apps&lt;/code&gt;&lt;/a&gt;&lt;/td&gt;
