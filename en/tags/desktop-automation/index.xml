        <description>&lt;img src="https://images.unsplash.com/photo-1644780439297-7408445e0ef0?ixid=M3w0NjAwMjJ8MHwxfHJhbmRvbXx8fHx8fHx8fDE3ODk5OTg5NDh8&amp;ixlib=rb-4.1.0" alt="Featured image of post cua" /&gt;&lt;h1 id=&#34;trycuacua&#34;&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/trycua/cua&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;trycua/cua&lt;/a&gt;
&lt;/h1&gt;&lt;div align=&#34;center&#34;&gt;
  &lt;a href=&#34;https://cua.ai&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34;&gt;
    &lt;picture&gt;
      &lt;source media=&#34;(prefers-color-scheme: dark)&#34; alt=&#34;Cua logo&#34; width=&#34;150&#34; srcset=&#34;img/logo_white.svg&#34;&gt;
      &lt;source media=&#34;(prefers-color-scheme: light)&#34; alt=&#34;Cua logo&#34; width=&#34;150&#34; srcset=&#34;img/logo_black.svg&#34;&gt;
      &lt;img alt=&#34;Cua logo&#34; width=&#34;150&#34; src=&#34;img/logo_black.svg&#34;&gt;
    &lt;/picture&gt;
  &lt;/a&gt;
  &lt;p align=&#34;center&#34;&gt;&lt;strong&gt;Give AI agents computers they can use.&lt;/strong&gt;&lt;br&gt;Cua provides open-source desktop automation, isolated cloud desktops, local macOS VMs, specialist decision models, and benchmarks for evaluating computer-use agents.&lt;/p&gt;
  &lt;p align=&#34;center&#34;&gt;&lt;strong&gt;&lt;a href=&#34;https://run.cua.ai/?utm_source=github&amp;utm_medium=referral&amp;utm_campaign=fleet_activation&amp;content_id=repo_readme&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34;&gt;Try Cua Fleets now at run.cua.ai&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;
  &lt;p align=&#34;center&#34;&gt;
    &lt;a href=&#34;https://cua.ai&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34;&gt;&lt;img src=&#34;https://img.shields.io/badge/cua.ai-0ea5e9&#34; alt=&#34;cua.ai&#34;&gt;&lt;/a&gt;
    &lt;a href=&#34;https://discord.gg/mVnXXpdE85&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34;&gt;&lt;img src=&#34;https://img.shields.io/badge/Discord-Join%20Server-10b981?logo=discord&amp;logoColor=white&#34; alt=&#34;Discord&#34;&gt;&lt;/a&gt;
    &lt;a href=&#34;https://x.com/trycua&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34;&gt;&lt;img src=&#34;https://img.shields.io/twitter/follow/trycua?style=social&#34; alt=&#34;Twitter&#34;&gt;&lt;/a&gt;
    &lt;a href=&#34;https://cua.ai/docs&#34; target=&#34;_blank&#34; rel=&#34;noopener noreferrer&#34;&gt;&lt;img src=&#34;https://img.shields.io/badge/Docs-0ea5e9.svg&#34; alt=&#34;Documentation&#34;&gt;&lt;/a&gt;
    &lt;br&gt;
&lt;a href=&#34;https://trendshift.io/repositories/13685&#34; target=&#34;_blank&#34;&gt;&lt;img src=&#34;https://trendshift.io/api/badge/repositories/13685&#34; alt=&#34;trycua%2Fcua | Trendshift&#34; style=&#34;width: 250px; height: 55px;&#34; width=&#34;250&#34; height=&#34;55&#34;/&gt;&lt;/a&gt;
  &lt;/p&gt;
&lt;/div&gt;
&lt;h2 id=&#34;choose-your-path&#34;&gt;Choose your path
&lt;/h2&gt;&lt;div align=&#34;center&#34;&gt;
  &lt;table width=&#34;100%&#34;&gt;
    &lt;tr&gt;
      &lt;td colspan=&#34;2&#34; align=&#34;center&#34; valign=&#34;top&#34; width=&#34;66.66%&#34;&gt;
        &lt;a href=&#34;#cua-fleets&#34;&gt;
          &lt;img src=&#34;img/card-cua-fleets-wide.gif&#34; alt=&#34;Cua Fleets: isolated cloud desktops for your agents&#34; width=&#34;100%&#34;&gt;
        &lt;/a&gt;
      &lt;/td&gt;
      &lt;td align=&#34;center&#34; valign=&#34;top&#34; width=&#34;33.33%&#34;&gt;
        &lt;a href=&#34;https://github.com/trycua/cua/tree/main/libs/cua-s1&#34;&gt;
          &lt;img src=&#34;img/card-cua-s1.gif&#34; alt=&#34;CUA-S1: small, specialized models for computer use.&#34; width=&#34;100%&#34;&gt;
        &lt;/a&gt;
      &lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
      &lt;td align=&#34;center&#34; valign=&#34;top&#34; width=&#34;33.33%&#34;&gt;
        &lt;a href=&#34;#cua-driver&#34;&gt;
          &lt;img src=&#34;img/card-cua-driver.gif&#34; alt=&#34;Cua Driver: inspect and operate apps on macOS, Windows, and Linux&#34; width=&#34;100%&#34;&gt;
        &lt;/a&gt;
      &lt;/td&gt;
      &lt;td align=&#34;center&#34; valign=&#34;top&#34; width=&#34;33.33%&#34;&gt;
        &lt;a href=&#34;#lume&#34;&gt;
          &lt;img src=&#34;img/card-cua-lume.gif&#34; alt=&#34;Lume: local macOS and Linux VMs on Apple Silicon&#34; width=&#34;100%&#34;&gt;
        &lt;/a&gt;
      &lt;/td&gt;
      &lt;td align=&#34;center&#34; valign=&#34;top&#34; width=&#34;33.33%&#34;&gt;
        &lt;a href=&#34;#cua-bench&#34;&gt;
          &lt;img src=&#34;img/card-cua-bench.gif&#34; alt=&#34;Cua Bench: create tasks, evaluate agents, and export trajectories&#34; width=&#34;100%&#34;&gt;
        &lt;/a&gt;
      &lt;/td&gt;
    &lt;/tr&gt;
  &lt;/table&gt;
&lt;/div&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Cua Fleets:&lt;/strong&gt; &lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/tutorials/your-first-cloud-fleet&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Provision a Linux desktop, run a command, and save a screenshot&lt;/a&gt;.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;CUA-S1:&lt;/strong&gt; &lt;a class=&#34;link&#34; href=&#34;#cua-s1&#34; &gt;Explore small, specialized models for computer-use decisions&lt;/a&gt;.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Cua Driver:&lt;/strong&gt; &lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/tutorials/drive-your-first-app&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Operate Calculator and verify its result&lt;/a&gt;.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Lume:&lt;/strong&gt; &lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/tutorials/create-your-first-lume-vm&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Create a Tahoe VM and connect over SSH&lt;/a&gt;.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Cua Bench:&lt;/strong&gt; &lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/tutorials/your-first-cua-bench-task&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Create and verify a simulated task&lt;/a&gt;.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Bring your own agent and model, or explore CUA-S1 for specialized decisions. Cua provides the computer and automation tools. &lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/concepts/what-is-computer-use&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Computer-Use 2.0&lt;/a&gt; describes an agent moving between code, APIs, and graphical interfaces within the same task.&lt;/p&gt;
&lt;h2 id=&#34;see-cua-driver-in-action&#34;&gt;See Cua Driver in action
&lt;/h2&gt;&lt;p&gt;Two Cua Driver sessions select cells in LibreOffice Calc and objects in Inkscape on an Omarchy desktop while a terminal stays in the foreground. Watch the 50-second demo, then explore &lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/how-to-guides/sandbox/run-omarchy-on-cloud-fleet&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Omarchy on Fleet&lt;/a&gt;.&lt;/p&gt;
&lt;p&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/user-attachments/assets/b4e5517c-d2db-4758-b4cf-07131b0753b2&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;https://github.com/user-attachments/assets/b4e5517c-d2db-4758-b4cf-07131b0753b2&lt;/a&gt;&lt;/p&gt;
&lt;hr&gt;
&lt;h2 id=&#34;cua-fleets&#34;&gt;Cua Fleets
&lt;/h2&gt;&lt;p&gt;Provision isolated cloud desktops at &lt;a class=&#34;link&#34; href=&#34;https://run.cua.ai/?utm_source=github&amp;amp;utm_medium=referral&amp;amp;utm_campaign=fleet_activation&amp;amp;content_id=repo_readme&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;run.cua.ai&lt;/a&gt;. A Fleet maintains sandbox capacity; your code claims a desktop from a pool and uses the Sandbox SDK to run commands, capture screenshots, and interact with apps inside it.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Your first result:&lt;/strong&gt; provision a Linux desktop, run &lt;code&gt;uname -a&lt;/code&gt;, save a screenshot, and delete the cloud resources. The tutorial covers Fleet credentials, dependencies, and cleanup. Pools can retain paid capacity after a claim ends, so follow its cleanup steps.&lt;/p&gt;
&lt;p&gt;Local sandboxes and Fleets share the Sandbox SDK, but credentials, images, operations, and runtime requirements differ. Use the &lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/reference/sandbox-sdk/runtime-support&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;runtime support reference&lt;/a&gt; to choose an environment. For your own hardware, see &lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/how-to-guides/sandbox/manage-local-lifecycle&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Manage local sandbox lifecycle&lt;/a&gt;.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/tutorials/your-first-cloud-fleet&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Your first Cloud Fleet&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/cloud-fleets&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Fleet overview&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/reference/sandbox-sdk&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Sandbox SDK reference&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;hr&gt;
&lt;h2 id=&#34;cua-driver&#34;&gt;Cua Driver
&lt;/h2&gt;&lt;p&gt;Give your agent tools to inspect and operate native desktop apps and browsers on macOS, Windows, and Linux. Connect through the CLI, MCP, or typed SDKs. Background delivery lets agents work without moving your pointer or taking focus when the app and platform support it; see &lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/reference/cua-driver/platform-support&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;platform support&lt;/a&gt; for the boundaries.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;macOS / Linux&lt;/strong&gt;&lt;/p&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-sh&#34; data-lang=&#34;sh&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;/bin/bash -c &lt;span class=&#34;s2&#34;&gt;&amp;#34;&lt;/span&gt;&lt;span class=&#34;k&#34;&gt;$(&lt;/span&gt;curl -fsSL https://cua.ai/driver/install.sh&lt;span class=&#34;k&#34;&gt;)&lt;/span&gt;&lt;span class=&#34;s2&#34;&gt;&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;&lt;strong&gt;Windows (PowerShell)&lt;/strong&gt;&lt;/p&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-powershell&#34; data-lang=&#34;powershell&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;nb&#34;&gt;irm &lt;/span&gt;&lt;span class=&#34;n&#34;&gt;https&lt;/span&gt;&lt;span class=&#34;err&#34;&gt;:&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;//&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;cua&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;.&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;ai&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;/&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;driver&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;/&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;install&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;.&lt;/span&gt;&lt;span class=&#34;py&#34;&gt;ps1&lt;/span&gt; &lt;span class=&#34;p&#34;&gt;|&lt;/span&gt; &lt;span class=&#34;nb&#34;&gt;iex
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;&lt;strong&gt;Your first result:&lt;/strong&gt; connect your agent, ask it to compute 6 × 7 in Calculator, and have it verify that the app displays 42. The tutorial covers platform setup, permissions, and agent connection.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/tutorials/drive-your-first-app&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Drive your first app&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/how-to-guides/driver/install&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Installation&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/reference/cua-driver/cli-reference&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;CLI Reference&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Using Claude Code, Codex, Cursor, OpenClaw, or another agent? &lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/how-to-guides/driver/connect-your-agent&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Find your integration&lt;/a&gt;. Source documentation and architecture notes live in &lt;a class=&#34;link&#34; href=&#34;libs/cua-driver/README.md&#34; &gt;&lt;code&gt;libs/cua-driver/README.md&lt;/code&gt;&lt;/a&gt;.&lt;/p&gt;
&lt;hr&gt;
&lt;h2 id=&#34;cua-s1&#34;&gt;CUA-S1
&lt;/h2&gt;&lt;p&gt;CUA-S1 is our family of small, specialized System 1 models for computer use. We use &amp;ldquo;System 1&amp;rdquo; as an engineering analogy for fast, bounded decisions, such as choosing which value belongs in a field or whether to leave an element alone. It is not a strict classification of model architectures or a replacement for a general-purpose agent&amp;rsquo;s planning and reasoning.&lt;/p&gt;
&lt;p&gt;The first research profile focuses on forms: scoring decisions from structured interface elements and document values rather than generating a response token by token. Application code orders the actions, and the optional Cua Driver integration handles execution with explicit action boundaries.&lt;/p&gt;
&lt;p&gt;The project includes Python model code, synthetic-data generation, training, and evaluation. The GitHub component is an early, source-only research release; model weights are hosted separately on Hugging Face. The source is MIT-licensed. Check each model and dataset card for its scope, limitations, and artifact-specific license.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;libs/cua-s1&#34; &gt;Explore CUA-S1&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;libs/cua-s1/MODEL_CARD.md&#34; &gt;Model card&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;libs/cua-s1/SECURITY.md&#34; &gt;Safety and deployment guidance&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;CUA-S1-FORMS on Hugging Face:&lt;/strong&gt; &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://huggingface.co/cua-ai/cua-s1-forms&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Model weights&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://huggingface.co/datasets/cua-ai/cua-s1-forms&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Dataset&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;hr&gt;
&lt;h2 id=&#34;lume&#34;&gt;Lume
&lt;/h2&gt;&lt;p&gt;Create and manage local macOS and Linux VMs on Apple Silicon using Apple&amp;rsquo;s Virtualization.Framework.&lt;/p&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-bash&#34; data-lang=&#34;bash&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;/bin/bash -c &lt;span class=&#34;s2&#34;&gt;&amp;#34;&lt;/span&gt;&lt;span class=&#34;k&#34;&gt;$(&lt;/span&gt;curl -fsSL https://cua.ai/lume/install.sh&lt;span class=&#34;k&#34;&gt;)&lt;/span&gt;&lt;span class=&#34;s2&#34;&gt;&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;&lt;strong&gt;Your first result:&lt;/strong&gt; create a vanilla macOS Tahoe VM from an Apple restore image, start it, and connect over SSH. The tutorial uses the Lume CLI directly and explains the unattended setup defaults.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/tutorials/create-your-first-lume-vm&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Create your first Lume VM&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/how-to-guides/lume/install-lume&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Installation&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/reference/lume/cli-reference&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;CLI reference&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;hr&gt;
&lt;h2 id=&#34;cua-bench&#34;&gt;Cua Bench
&lt;/h2&gt;&lt;p&gt;Build computer-use tasks, evaluate agents, and export trajectories for training. Start with a simulated task that requires no VM, Docker, or model API key.&lt;/p&gt;
&lt;p&gt;With Python 3.12 or 3.13 and &lt;a class=&#34;link&#34; href=&#34;https://docs.astral.sh/uv/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;uv&lt;/a&gt; installed:&lt;/p&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;2
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-bash&#34; data-lang=&#34;bash&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;uv tool install &lt;span class=&#34;s1&#34;&gt;&amp;#39;cua-bench[browser]&amp;#39;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;uv tool run --from &lt;span class=&#34;s1&#34;&gt;&amp;#39;cua-bench[browser]&amp;#39;&lt;/span&gt; playwright install chromium
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;&lt;strong&gt;Your first result:&lt;/strong&gt; create a small task, run its reference solution, and verify that its evaluator reports a reward of &lt;code&gt;1.0&lt;/code&gt;. Then try the same task yourself.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/tutorials/your-first-cua-bench-task&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Build your first task&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/concepts/what-is-cua-bench&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;What is Cua-Bench?&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cua.ai/docs/reference/cua-bench/cli-reference&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;CLI reference&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://cuabench.ai/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Partner with us&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;
