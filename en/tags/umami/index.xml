  &lt;a href=&#34;https://umami.is/discord&#34;&gt;
    &lt;img src=&#34;https://img.shields.io/badge/Discord--blue?style=social&amp;logo=discord&#34; alt=&#34;Discord&#34; /&gt;
  &lt;/a&gt;
&lt;/p&gt;
