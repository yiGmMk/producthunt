  &lt;source
    media=&#34;(prefers-color-scheme: light)&#34;
    srcset=&#34;https://cdn.builder.io/api/v1/image/assets%2FYJIGb4i01jvw0SRdL5Bt%2F7628600bc10a4940b78f42c5df7628b0&#34;
