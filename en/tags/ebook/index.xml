&lt;/h1&gt;&lt;p&gt;&lt;img src=&#34;https://img.shields.io/badge/Python-3.x-blue.svg&#34;
	
	
	
	loading=&#34;lazy&#34;
	
		alt=&#34;Python Version&#34;
	
	
