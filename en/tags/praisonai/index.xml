      &lt;img src=&#34;https://img.shields.io/badge/%F0%9F%93%9A_Models-Visit_docs.praison.ai-blue?style=for-the-badge&amp;logo=bookstack&amp;logoColor=white&#34; alt=&#34;Models&#34; /&gt;
    &lt;/p&gt;
  &lt;/a&gt;
