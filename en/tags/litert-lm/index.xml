			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td style=&#34;text-align: left&#34;&gt;&lt;a class=&#34;link&#34; href=&#34;https://developers.googleblog.com/bring-state-of-the-art-agentic-skills-to-the-edge-with-gemma-4/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Bring state-of-the-art agentic skills to the edge with Gemma 4&lt;/a&gt;&lt;/td&gt;
					&lt;td style=&#34;text-align: left&#34;&gt;Deploy Gemma 4 in-app and across a broader range of devices with stellar performance and broad reach using LiteRT-LM.&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td style=&#34;text-align: left&#34;&gt;&lt;a class=&#34;link&#34; href=&#34;https://developers.googleblog.com/on-device-genai-in-chrome-chromebook-plus-and-pixel-watch-with-litert-lm/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;On-device GenAI in Chrome, Chromebook Plus and Pixel Watch&lt;/a&gt;&lt;/td&gt;
