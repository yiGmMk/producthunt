	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th style=&#34;text-align: center&#34;&gt;&lt;strong&gt;Install the app today from Google Play&lt;/strong&gt;&lt;/th&gt;
					&lt;th style=&#34;text-align: center&#34;&gt;&lt;strong&gt;Install the app today from App Store&lt;/strong&gt;&lt;/th&gt;
