			&lt;tr&gt;
					&lt;td style=&#34;text-align: left&#34;&gt;&lt;a class=&#34;link&#34; href=&#34;https://developers.googleblog.com/on-device-function-calling-in-google-ai-edge-gallery/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
