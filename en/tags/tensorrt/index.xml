					&lt;td&gt;&lt;a class=&#34;link&#34; href=&#34;docs/text-to-image.md&#34; &gt;Text to Image&lt;/a&gt;&lt;/td&gt;
					&lt;td&gt;&lt;a class=&#34;link&#34; href=&#34;https://huggingface.co/black-forest-labs/FLUX.1-dev&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
