        <guid>https://producthunt.programnotes.cn/en/p/orca/</guid>
        <description>&lt;img src="https://images.unsplash.com/photo-1685495856041-23c24dce1548?ixid=M3w0NjAwMjJ8MHwxfHJhbmRvbXx8fHx8fHx8fDE3ODY2MTAwODV8&amp;ixlib=rb-4.1.0" alt="Featured image of post orca" /&gt;&lt;h1 id=&#34;stablyaiorca&#34;&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/stablyai/orca&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;stablyai/orca&lt;/a&gt;
&lt;/h1&gt;&lt;h1 align=&#34;center&#34;&gt;
  &lt;a href=&#34;https://onOrca.dev&#34;&gt;&lt;img src=&#34;resources/build/icon.png&#34; alt=&#34;Orca&#34; width=&#34;64&#34; valign=&#34;middle&#34; /&gt;&lt;/a&gt; Orca
&lt;/h1&gt;
&lt;p align=&#34;center&#34;&gt;
  &lt;a href=&#34;https://github.com/stablyai/orca&#34;&gt;&lt;img src=&#34;https://img.shields.io/github/stars/stablyai/orca?style=flat&amp;amp;label=%E2%98%85&amp;amp;color=08C&#34; alt=&#34;GitHub stars&#34; /&gt;&lt;/a&gt;
  &lt;a href=&#34;https://github.com/stablyai/orca/releases&#34;&gt;&lt;img src=&#34;docs/assets/readme-downloads.svg&#34; alt=&#34;Total downloads across all releases&#34; /&gt;&lt;/a&gt;
  &lt;img src=&#34;https://img.shields.io/badge/license-MIT-08C?style=flat&#34; alt=&#34;License: MIT&#34; /&gt;
  &lt;a href=&#34;https://discord.gg/fzjDKHxv8Q&#34;&gt;&lt;img src=&#34;https://img.shields.io/badge/Discord-5865F2?logo=discord&amp;logoColor=white&#34; alt=&#34;Join the Orca Discord&#34; /&gt;&lt;/a&gt;
  &lt;a href=&#34;https://x.com/orca_build&#34;&gt;&lt;img src=&#34;https://img.shields.io/badge/X-000000?logo=x&amp;logoColor=white&#34; alt=&#34;Follow Orca on X&#34; /&gt;&lt;/a&gt;
  &lt;img src=&#34;https://img.shields.io/badge/macOS%20%7C%20Windows%20%7C%20Linux-4493F8?style=flat-square&#34; alt=&#34;Supported platforms: macOS, Windows, and Linux&#34; /&gt;
&lt;/p&gt;
&lt;p align=&#34;center&#34;&gt;
  &lt;sub&gt;&lt;a href=&#34;docs/readme/README.zh-CN.md&#34;&gt;中文&lt;/a&gt; · &lt;a href=&#34;docs/readme/README.ja.md&#34;&gt;日本語&lt;/a&gt; · &lt;a href=&#34;docs/readme/README.ko.md&#34;&gt;한국어&lt;/a&gt; · &lt;a href=&#34;docs/readme/README.es.md&#34;&gt;Español&lt;/a&gt; · &lt;a href=&#34;docs/readme/README.fr.md&#34;&gt;Français&lt;/a&gt; · &lt;a href=&#34;docs/readme/README.pt.md&#34;&gt;Português&lt;/a&gt;&lt;/sub&gt;
&lt;/p&gt;
&lt;p align=&#34;center&#34;&gt;
  &lt;strong&gt;The AI Orchestrator for 100x builders.&lt;/strong&gt;&lt;br/&gt;
  Run Codex, ClaudeCode, OpenCode or Pi side-by-side — each in its own worktree, tracked in one place.
&lt;/p&gt;
&lt;h3 align=&#34;center&#34;&gt;&lt;a href=&#34;https://onorca.dev/download&#34;&gt;&lt;ins&gt;Download Orca&lt;/ins&gt;&lt;/a&gt;&lt;/h3&gt;
&lt;p align=&#34;center&#34;&gt;
  &lt;img src=&#34;docs/assets/readme-hero.jpg&#34; alt=&#34;Orca desktop app running agents in parallel worktrees, with the Orca mobile companion app in the corner&#34; width=&#34;960&#34; /&gt;
&lt;/p&gt;
&lt;h2 id=&#34;features&#34;&gt;Features
&lt;/h2&gt;&lt;table&gt;
&lt;tr&gt;
&lt;td width=&#34;50%&#34; valign=&#34;middle&#34;&gt;
&lt;h3 id=&#34;mobile-companion&#34;&gt;Mobile Companion
&lt;/h3&gt;&lt;p&gt;Monitor and steer your agents from your phone — get notified when an agent finishes and send follow-ups from anywhere.&lt;/p&gt;
&lt;p&gt;&lt;a class=&#34;link&#34; href=&#34;https://apps.apple.com/us/app/orca-ide/id6766130217&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;iOS App Store&lt;/a&gt; · &lt;a class=&#34;link&#34; href=&#34;https://testflight.apple.com/join/YjeGMQBA&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;TestFlight&lt;/a&gt; · &lt;a class=&#34;link&#34; href=&#34;https://github.com/stablyai/orca/releases/download/mobile-android-v0.0.42/app-release.apk&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Android APK 0.0.42&lt;/a&gt; · &lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/mobile&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Docs →&lt;/a&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td width=&#34;50%&#34;&gt;
  &lt;a href=&#34;https://www.onorca.dev/docs/mobile&#34;&gt;&lt;picture&gt;&lt;source srcset=&#34;docs/assets/feature-wall/mobile-companion-app-showcase.gif&#34; type=&#34;image/gif&#34;&gt;&lt;img src=&#34;docs/assets/feature-wall/mobile-companion-app-showcase.jpg&#34; alt=&#34;Orca desktop with the mobile companion app&#34; width=&#34;100%&#34; /&gt;&lt;/picture&gt;&lt;/a&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td width=&#34;50%&#34; valign=&#34;middle&#34;&gt;
&lt;h3 id=&#34;parallel-worktrees&#34;&gt;Parallel Worktrees
&lt;/h3&gt;&lt;p&gt;Fan one prompt across five agents, each in its own isolated git worktree — compare the results and merge the winner.&lt;/p&gt;
&lt;p&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/model/worktrees&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Docs →&lt;/a&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td width=&#34;50%&#34;&gt;
  &lt;a href=&#34;https://www.onorca.dev/docs/model/worktrees&#34;&gt;&lt;picture&gt;&lt;source srcset=&#34;docs/assets/feature-wall/parallel-worktrees.gif&#34; type=&#34;image/gif&#34;&gt;&lt;img src=&#34;docs/assets/feature-wall/parallel-worktrees.jpg&#34; alt=&#34;Parallel worktree orchestration&#34; width=&#34;100%&#34; /&gt;&lt;/picture&gt;&lt;/a&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td width=&#34;50%&#34; valign=&#34;middle&#34;&gt;
&lt;h3 id=&#34;terminal-splits&#34;&gt;Terminal Splits
&lt;/h3&gt;&lt;p&gt;Ghostty-class terminals with WebGL rendering, infinite splits, and scrollback that survives restarts.&lt;/p&gt;
&lt;p&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/terminal&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Docs →&lt;/a&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td width=&#34;50%&#34;&gt;
  &lt;a href=&#34;https://www.onorca.dev/docs/terminal&#34;&gt;&lt;picture&gt;&lt;source srcset=&#34;docs/assets/feature-wall/terminal-splits.gif&#34; type=&#34;image/gif&#34;&gt;&lt;img src=&#34;docs/assets/feature-wall/terminal-splits.jpg&#34; alt=&#34;Terminal splits&#34; width=&#34;100%&#34; /&gt;&lt;/picture&gt;&lt;/a&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td width=&#34;50%&#34; valign=&#34;middle&#34;&gt;
&lt;h3 id=&#34;design-mode&#34;&gt;Design Mode
&lt;/h3&gt;&lt;p&gt;Click any UI element in a real Chromium window to send its HTML, CSS, and a cropped screenshot straight into your agent&amp;rsquo;s prompt.&lt;/p&gt;
&lt;p&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/browser/design-mode&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Docs →&lt;/a&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td width=&#34;50%&#34;&gt;
  &lt;a href=&#34;https://www.onorca.dev/docs/browser/design-mode&#34;&gt;&lt;picture&gt;&lt;source srcset=&#34;docs/assets/feature-wall/design-mode.gif&#34; type=&#34;image/gif&#34;&gt;&lt;img src=&#34;docs/assets/feature-wall/design-mode.jpg&#34; alt=&#34;Embedded browser and Design Mode&#34; width=&#34;100%&#34; /&gt;&lt;/picture&gt;&lt;/a&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td width=&#34;50%&#34; valign=&#34;middle&#34;&gt;
&lt;h3 id=&#34;github--linear-native&#34;&gt;GitHub &amp;amp; Linear, Native
&lt;/h3&gt;&lt;p&gt;Browse PRs, issues, and project boards in-app — open a worktree from any task and review without a context switch.&lt;/p&gt;
&lt;p&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/review/linear&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Docs →&lt;/a&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td width=&#34;50%&#34;&gt;
  &lt;a href=&#34;https://www.onorca.dev/docs/review/linear&#34;&gt;&lt;picture&gt;&lt;source srcset=&#34;docs/assets/feature-wall/github-linear.gif&#34; type=&#34;image/gif&#34;&gt;&lt;img src=&#34;docs/assets/feature-wall/github-linear.jpg&#34; alt=&#34;GitHub and Linear task workflows in Orca&#34; width=&#34;100%&#34; /&gt;&lt;/picture&gt;&lt;/a&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td width=&#34;50%&#34; valign=&#34;middle&#34;&gt;
&lt;h3 id=&#34;ssh-worktrees&#34;&gt;SSH Worktrees
&lt;/h3&gt;&lt;p&gt;Run agents on a beefy remote box with full file editing, git, and terminals — auto-reconnect and port forwarding included.&lt;/p&gt;
&lt;p&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/ssh&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Docs →&lt;/a&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td width=&#34;50%&#34;&gt;
  &lt;a href=&#34;https://www.onorca.dev/docs/ssh&#34;&gt;&lt;picture&gt;&lt;source srcset=&#34;docs/assets/feature-wall/ssh-worktrees.gif&#34; type=&#34;image/gif&#34;&gt;&lt;img src=&#34;docs/assets/feature-wall/ssh-worktrees.jpg&#34; alt=&#34;Remote worktrees over SSH&#34; width=&#34;100%&#34; /&gt;&lt;/picture&gt;&lt;/a&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td width=&#34;50%&#34; valign=&#34;middle&#34;&gt;
&lt;h3 id=&#34;annotate-ai-diffs&#34;&gt;Annotate AI Diffs
&lt;/h3&gt;&lt;p&gt;Drop comments on any diff line and ship them back to the agent — review, edit, and commit without leaving Orca.&lt;/p&gt;
&lt;p&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/review/annotate-ai-diff&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Docs →&lt;/a&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td width=&#34;50%&#34;&gt;
  &lt;a href=&#34;https://www.onorca.dev/docs/review/annotate-ai-diff&#34;&gt;&lt;picture&gt;&lt;source srcset=&#34;docs/assets/feature-wall/annotate-diff.gif&#34; type=&#34;image/gif&#34;&gt;&lt;img src=&#34;docs/assets/feature-wall/annotate-diff.jpg&#34; alt=&#34;Annotate AI-generated diffs&#34; width=&#34;100%&#34; /&gt;&lt;/picture&gt;&lt;/a&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td width=&#34;50%&#34; valign=&#34;middle&#34;&gt;
&lt;h3 id=&#34;drag-files-to-agents&#34;&gt;Drag Files to Agents
&lt;/h3&gt;&lt;p&gt;VS Code&amp;rsquo;s editor with autosave everywhere — drag files or images straight into an agent prompt.&lt;/p&gt;
&lt;p&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/editing/file-explorer&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Docs →&lt;/a&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td width=&#34;50%&#34;&gt;
  &lt;a href=&#34;https://www.onorca.dev/docs/editing/file-explorer&#34;&gt;&lt;picture&gt;&lt;source srcset=&#34;docs/assets/feature-wall/file-drag.gif&#34; type=&#34;image/gif&#34;&gt;&lt;img src=&#34;docs/assets/feature-wall/file-drag.jpg&#34; alt=&#34;Drag files and images into an agent prompt&#34; width=&#34;100%&#34; /&gt;&lt;/picture&gt;&lt;/a&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td width=&#34;50%&#34; valign=&#34;middle&#34;&gt;
&lt;h3 id=&#34;orca-cli&#34;&gt;Orca CLI
&lt;/h3&gt;&lt;p&gt;Agents drive Orca too — script every workflow with &lt;code&gt;orca worktree create&lt;/code&gt;, &lt;code&gt;snapshot&lt;/code&gt;, &lt;code&gt;click&lt;/code&gt;, and &lt;code&gt;fill&lt;/code&gt;.&lt;/p&gt;
&lt;p&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/cli/overview&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Docs →&lt;/a&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td width=&#34;50%&#34;&gt;
  &lt;a href=&#34;https://www.onorca.dev/docs/cli/overview&#34;&gt;&lt;picture&gt;&lt;source srcset=&#34;docs/assets/feature-wall/orca-cli.gif&#34; type=&#34;image/gif&#34;&gt;&lt;img src=&#34;docs/assets/feature-wall/orca-cli.jpg&#34; alt=&#34;Script Orca from the CLI&#34; width=&#34;100%&#34; /&gt;&lt;/picture&gt;&lt;/a&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;
&lt;p&gt;&lt;strong&gt;Also in the box:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/model/quick-open&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Quick open&lt;/a&gt;&lt;/strong&gt; — Search across worktrees, files, agents, commands, and repo context without leaving your flow.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/agents/usage-tracking&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Account switcher &amp;amp; usage tracking&lt;/a&gt;&lt;/strong&gt; — See Claude and Codex usage and rate-limit resets, and hot-swap accounts without re-logging in.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/editing/markdown&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Rich repo previews&lt;/a&gt;&lt;/strong&gt; — Preview Markdown, images, PDFs, and repo docs in the workspace.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/cli/computer-use&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Computer Use&lt;/a&gt;&lt;/strong&gt; — Let agents operate desktop apps and visible UI when a workflow needs real interaction.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;&lt;a class=&#34;link&#34; href=&#34;https://www.onorca.dev/docs/notifications&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Notifications and unread state&lt;/a&gt;&lt;/strong&gt; — Know when an agent finishes or needs attention, then mark threads unread to come back later.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;And many, many more&lt;/strong&gt; — we ship daily, so this list is perpetually behind. The &lt;a class=&#34;link&#34; href=&#34;https://github.com/stablyai/orca/releases&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;changelog&lt;/a&gt; is the real feature list.&lt;/li&gt;
&lt;/ul&gt;
&lt;hr&gt;
&lt;h2 id=&#34;supported-agents&#34;&gt;Supported Agents
&lt;/h2&gt;&lt;p&gt;Works with &lt;strong&gt;any CLI agent&lt;/strong&gt; — if it runs in a terminal, it runs in Orca.&lt;/p&gt;
&lt;p&gt;
  &lt;a href=&#34;https://docs.anthropic.com/claude/docs/claude-code&#34;&gt;&lt;kbd&gt;&lt;img src=&#34;docs/assets/claude-logo.svg&#34; alt=&#34;Claude Code logo&#34; width=&#34;16&#34; valign=&#34;middle&#34; /&gt; Claude Code&lt;/kbd&gt;&lt;/a&gt; &amp;nbsp;
  &lt;a href=&#34;https://github.com/openai/codex&#34;&gt;&lt;kbd&gt;&lt;img src=&#34;https://www.google.com/s2/favicons?domain=openai.com&amp;sz=64&#34; alt=&#34;Codex logo&#34; width=&#34;16&#34; valign=&#34;middle&#34; /&gt; Codex&lt;/kbd&gt;&lt;/a&gt; &amp;nbsp;
  &lt;a href=&#34;https://x.ai/cli&#34;&gt;&lt;kbd&gt;&lt;img src=&#34;https://www.google.com/s2/favicons?domain=x.ai&amp;sz=64&#34; alt=&#34;Grok logo&#34; width=&#34;16&#34; valign=&#34;middle&#34; /&gt; Grok&lt;/kbd&gt;&lt;/a&gt; &amp;nbsp;
  &lt;a href=&#34;https://cursor.com/cli&#34;&gt;&lt;kbd&gt;&lt;img src=&#34;https://www.google.com/s2/favicons?domain=cursor.com&amp;sz=64&#34; alt=&#34;Cursor logo&#34; width=&#34;16&#34; valign=&#34;middle&#34; /&gt; Cursor&lt;/kbd&gt;&lt;/a&gt; &amp;nbsp;
  &lt;a href=&#34;https://docs.github.com/en/copilot/how-tos/set-up/install-copilot-cli&#34;&gt;&lt;kbd&gt;&lt;img src=&#34;https://www.google.com/s2/favicons?domain=github.com&amp;sz=64&#34; alt=&#34;GitHub Copilot logo&#34; width=&#34;16&#34; valign=&#34;middle&#34; /&gt; GitHub Copilot&lt;/kbd&gt;&lt;/a&gt; &amp;nbsp;
  &lt;a href=&#34;https://opencode.ai/docs/cli/&#34;&gt;&lt;kbd&gt;&lt;img src=&#34;https://www.google.com/s2/favicons?domain=opencode.ai&amp;sz=64&#34; alt=&#34;OpenCode logo&#34; width=&#34;16&#34; valign=&#34;middle&#34; /&gt; OpenCode&lt;/kbd&gt;&lt;/a&gt; &amp;nbsp;
  &lt;a href=&#34;https://mimo.xiaomi.com/coder&#34;&gt;&lt;kbd&gt;&lt;img src=&#34;https://www.google.com/s2/favicons?domain=mimo.xiaomi.com&amp;sz=64&#34; alt=&#34;MiMo Code logo&#34; width=&#34;16&#34; valign=&#34;middle&#34; /&gt; MiMo Code&lt;/kbd&gt;&lt;/a&gt; &amp;nbsp;
  &lt;a href=&#34;https://ampcode.com/manual#install&#34;&gt;&lt;kbd&gt;&lt;img src=&#34;https://www.google.com/s2/favicons?domain=ampcode.com&amp;sz=64&#34; alt=&#34;Amp logo&#34; width=&#34;16&#34; valign=&#34;middle&#34; /&gt; Amp&lt;/kbd&gt;&lt;/a&gt; &amp;nbsp;
  &lt;a href=&#34;https://openclaude.gitlawb.com/&#34;&gt;&lt;kbd&gt;&lt;img src=&#34;resources/openclaude-logo.png&#34; alt=&#34;OpenClaude logo&#34; width=&#34;16&#34; valign=&#34;middle&#34; /&gt; OpenClaude&lt;/kbd&gt;&lt;/a&gt; &amp;nbsp;
  &lt;a href=&#34;https://antigravity.google/docs/cli-overview&#34;&gt;&lt;kbd&gt;&lt;img src=&#34;https://www.google.com/s2/favicons?domain=antigravity.google&amp;sz=64&#34; alt=&#34;Antigravity logo&#34; width=&#34;16&#34; valign=&#34;middle&#34; /&gt; Antigravity&lt;/kbd&gt;&lt;/a&gt; &amp;nbsp;
  &lt;a href=&#34;https://pi.dev&#34;&gt;&lt;kbd&gt;&lt;img src=&#34;https://pi.dev/favicon.svg&#34; alt=&#34;Pi logo&#34; width=&#34;16&#34; valign=&#34;middle&#34; /&gt; Pi&lt;/kbd&gt;&lt;/a&gt; &amp;nbsp;
  &lt;a href=&#34;https://omp.sh&#34;&gt;&lt;kbd&gt;&lt;img src=&#34;https://omp.sh/favicon.svg&#34; alt=&#34;oh-my-pi logo&#34; width=&#34;16&#34; valign=&#34;middle&#34; /&gt; oh-my-pi&lt;/kbd&gt;&lt;/a&gt; &amp;nbsp;
