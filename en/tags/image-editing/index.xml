					&lt;td&gt;&lt;code&gt;FLUX.1 Fill [dev]&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;a class=&#34;link&#34; href=&#34;docs/fill.md&#34; &gt;In/Out-painting&lt;/a&gt;&lt;/td&gt;
					&lt;td&gt;&lt;a class=&#34;link&#34; href=&#34;https://huggingface.co/black-forest-labs/FLUX.1-Fill-dev&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;https://huggingface.co/black-forest-labs/FLUX.1-Fill-dev&lt;/a&gt;&lt;/td&gt;
