					&lt;td&gt;&lt;a class=&#34;link&#34; href=&#34;https://huggingface.co/black-forest-labs/FLUX.1-Depth-dev-lora&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;https://huggingface.co/black-forest-labs/FLUX.1-Depth-dev-lora&lt;/a&gt;&lt;/td&gt;
					&lt;td&gt;&lt;a class=&#34;link&#34; href=&#34;model_licenses/LICENSE-FLUX1-dev&#34; &gt;FLUX.1-dev Non-Commercial License&lt;/a&gt;&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;FLUX.1 Redux [dev]&lt;/code&gt;&lt;/td&gt;
