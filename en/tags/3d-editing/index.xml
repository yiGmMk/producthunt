    &gt;&lt;img src=&#34;https://img.shields.io/badge/Discord-5865F2?style=flat&amp;amp;logo=discord&amp;amp;logoColor=white&amp;amp;color=black&#34;
	
	
	
	loading=&#34;lazy&#34;
	
