&lt;p&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/browser-use/browser-use/blob/main/examples/use-cases/buy_groceries.py&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Example code ↗&lt;/a&gt;&lt;/p&gt;
