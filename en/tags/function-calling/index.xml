&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/langchain4j/langchain4j-examples/tree/main/spring-boot-example/src/main/java/dev/langchain4j/example&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
