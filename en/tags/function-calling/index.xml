&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/helidon-io/helidon-examples/tree/helidon-4.x/examples/integrations/langchain4j&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
