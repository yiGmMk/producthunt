					&lt;td&gt;Global&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;~/.cursor/mcp.json&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;%USERPROFILE%\.cursor\mcp.json&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;&lt;code&gt;mcpServers&lt;/code&gt;&lt;/td&gt;
