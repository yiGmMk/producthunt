					&lt;td&gt;Annotate Storybook stories with notes&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;a class=&#34;link&#34; href=&#34;https://storybook.js.org/addons/@storybook/addon-contexts/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;contexts&lt;/a&gt;&lt;/td&gt;
					&lt;td&gt;Addon for driving your components under dynamic contexts&lt;/td&gt;
