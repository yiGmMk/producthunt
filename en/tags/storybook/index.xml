					&lt;td&gt;Annotate stories with extra component usage information&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/storybookjs/deprecated-addons/tree/master/addons/notes&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
