&lt;a class=&#34;link&#34; href=&#34;https://owasp.org/projects/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;&lt;img src=&#34;https://img.shields.io/badge/OWASP-Lab%20project-f7b73c.svg&#34;
	
	
	
