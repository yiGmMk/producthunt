&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;#install-yarn&#34; &gt;Install Yarn&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;#install-node-dependencies&#34; &gt;Install Node Dependencies&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;#install-python-39&#34; &gt;Install Python 3.9&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;#install-python-dependencies&#34; &gt;Install Python Dependencies&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
