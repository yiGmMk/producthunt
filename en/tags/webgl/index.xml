&lt;a class=&#34;link&#34; href=&#34;https://github.com/mrdoob/three.js/wiki&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Wiki&lt;/a&gt; —
&lt;a class=&#34;link&#34; href=&#34;https://github.com/mrdoob/three.js/wiki/Migration-Guide&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
