    &lt;tr&gt;
        &lt;td&gt;Intel: Core i3 or higher&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;td&gt;RAM&lt;/td&gt;
        &lt;td&gt;4GB or more&lt;/td&gt;
    &lt;/tr&gt;
    &lt;tr&gt;
        &lt;td rowspan=&#34;5&#34;&gt;OS&lt;/td&gt;
