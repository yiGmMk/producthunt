&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;20
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-fallback&#34; data-lang=&#34;fallback&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;viking://
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;├── resources/              # Resources: project docs, repos, web pages, etc.
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│   └── my_project/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       ├── docs/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       │   ├── api/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       │   └── tutorials/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;│       └── src/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;└── user/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;    └── {user_id}/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;        ├── memories/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;        │   └── preferences/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;        │       ├── writing_style
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;        │       └── coding_habits
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;        ├── resources/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;        │   └── private_project/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;        ├── skills/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;        │   ├── search_code
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;        │   └── analyze_data
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;        └── peers/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;            └── web-visitor-alice/
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;The three loading tiers:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;L0 (Abstract)&lt;/strong&gt;: a one-sentence summary for quick relevance checks.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;L1 (Overview)&lt;/strong&gt;: core information and usage scenarios for planning.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;L2 (Details)&lt;/strong&gt;: the full original data, read only when needed.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Each directory carries its own L0/L1 layers, so relevance can be judged before any full file is read:&lt;/p&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;2
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;3
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;4
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;5
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;6
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;7
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;8
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;9
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-gdscript3&#34; data-lang=&#34;gdscript3&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;n&#34;&gt;viking&lt;/span&gt;&lt;span class=&#34;p&#34;&gt;:&lt;/span&gt;&lt;span class=&#34;o&#34;&gt;//&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;resources&lt;/span&gt;&lt;span class=&#34;o&#34;&gt;/&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;my_project&lt;/span&gt;&lt;span class=&#34;o&#34;&gt;/&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;err&#34;&gt;├──&lt;/span&gt; &lt;span class=&#34;o&#34;&gt;.&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;abstract&lt;/span&gt;               &lt;span class=&#34;c1&#34;&gt;# L0: ~100 tokens - quick relevance check&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;err&#34;&gt;├──&lt;/span&gt; &lt;span class=&#34;o&#34;&gt;.&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;overview&lt;/span&gt;               &lt;span class=&#34;c1&#34;&gt;# L1: ~2k tokens - structure and key points&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;err&#34;&gt;└──&lt;/span&gt; &lt;span class=&#34;n&#34;&gt;docs&lt;/span&gt;&lt;span class=&#34;o&#34;&gt;/&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;    &lt;span class=&#34;err&#34;&gt;├──&lt;/span&gt; &lt;span class=&#34;o&#34;&gt;.&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;abstract&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;    &lt;span class=&#34;err&#34;&gt;├──&lt;/span&gt; &lt;span class=&#34;o&#34;&gt;.&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;overview&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;    &lt;span class=&#34;err&#34;&gt;└──&lt;/span&gt; &lt;span class=&#34;n&#34;&gt;api&lt;/span&gt;&lt;span class=&#34;o&#34;&gt;/&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;        &lt;span class=&#34;err&#34;&gt;├──&lt;/span&gt; &lt;span class=&#34;n&#34;&gt;auth&lt;/span&gt;&lt;span class=&#34;o&#34;&gt;.&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;md&lt;/span&gt;         &lt;span class=&#34;c1&#34;&gt;# L2: full content, loaded on demand&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;        &lt;span class=&#34;err&#34;&gt;└──&lt;/span&gt; &lt;span class=&#34;n&#34;&gt;endpoints&lt;/span&gt;&lt;span class=&#34;o&#34;&gt;.&lt;/span&gt;&lt;span class=&#34;n&#34;&gt;md&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;h2 id=&#34;proof-it-works&#34;&gt;Proof it works
&lt;/h2&gt;&lt;p&gt;OpenViking 0.3.22 has been evaluated on long-conversation user memory (LoCoMo) and multi-turn agent tasks (tau2-bench). Full results and setup details, including knowledge-base QA, are in the &lt;a class=&#34;link&#34; href=&#34;https://blog.openviking.ai/post/openviking-benchmark-results/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;benchmark report&lt;/a&gt;; reproduction scripts live in &lt;a class=&#34;link&#34; href=&#34;./benchmark&#34; &gt;./benchmark&lt;/a&gt;.&lt;/p&gt;
&lt;picture&gt;
  &lt;source media=&#34;(prefers-color-scheme: dark)&#34; srcset=&#34;docs/images/benchmark-dark.svg&#34;&gt;
  &lt;img alt=&#34;Benchmark results. LoCoMo accuracy: OpenClaw 24.20% native vs 82.08% with OpenViking; Hermes 33.38% vs 82.86%; Claude Code 57.21% vs 80.32%. tau2-bench task success: Retail 70.94% vs 77.81%; Airline 54.38% vs 66.25%.&#34; src=&#34;docs/images/benchmark-light.svg&#34;&gt;
&lt;/picture&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;User memory (LoCoMo)&lt;/strong&gt;: with OpenViking, all three agent integrations land at 80–83% accuracy — up from 24–57% on their native memory — while input tokens drop by 34.3–91.0% and query latency by 58.45–66.10%.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Agent experience (tau2-bench)&lt;/strong&gt;: experience memory lifts task success by +6.87pp (retail) and +11.87pp (airline) over the same LLM without memory.&lt;/li&gt;
&lt;/ul&gt;
&lt;h2 id=&#34;quick-start&#34;&gt;Quick start
&lt;/h2&gt;&lt;blockquote&gt;
&lt;p&gt;💡 &lt;strong&gt;Want to see it in action first?&lt;/strong&gt; Try &lt;a class=&#34;link&#34; href=&#34;https://openviking.ai/studio&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;OpenViking Studio&lt;/a&gt; — a live hosted instance with a context playground, semantic search, and a multi-agent hub. No installation required.&lt;/p&gt;
&lt;/blockquote&gt;
&lt;p&gt;Requires Python 3.10 or higher.&lt;/p&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;2
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;3
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;4
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-bash&#34; data-lang=&#34;bash&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;pip install openviking --upgrade
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;openviking-server init      &lt;span class=&#34;c1&#34;&gt;# interactive wizard: providers, models, ov.conf&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;openviking-server doctor    &lt;span class=&#34;c1&#34;&gt;# validate setup&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;openviking-server           &lt;span class=&#34;c1&#34;&gt;# start (background: nohup openviking-server &amp;gt; openviking.log 2&amp;gt;&amp;amp;1 &amp;amp;)&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;&lt;code&gt;init&lt;/code&gt; walks you through provider setup and writes &lt;code&gt;~/.openviking/ov.conf&lt;/code&gt;. It supports Volcengine, OpenAI, Codex OAuth, Kimi, GLM, and local Ollama — for Ollama it can detect and install the runtime and pull models suited to your hardware. &lt;code&gt;doctor&lt;/code&gt; checks the config file, Python version, provider connectivity, and disk space without a running server. Manual &lt;code&gt;ov.conf&lt;/code&gt; templates, per-provider examples, environment variables, and Windows setup: &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/guides/01-configuration&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Configuration guide&lt;/a&gt; · &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/getting-started/02-quickstart&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Quick start docs&lt;/a&gt;.&lt;/p&gt;
&lt;p&gt;The install already includes the &lt;code&gt;ov&lt;/code&gt; client CLI. With the server running:&lt;/p&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;2
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;3
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;4
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;5
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;6
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;7
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-bash&#34; data-lang=&#34;bash&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;ov status
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;ov add-resource https://github.com/volcengine/OpenViking &lt;span class=&#34;c1&#34;&gt;# --wait&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;ov ls viking://resources/
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;ov tree viking://resources/volcengine -L &lt;span class=&#34;m&#34;&gt;2&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;&lt;span class=&#34;c1&#34;&gt;# wait some time for semantic processing if not --wait&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;ov find &lt;span class=&#34;s2&#34;&gt;&amp;#34;what is openviking&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;ov grep &lt;span class=&#34;s2&#34;&gt;&amp;#34;openviking&amp;#34;&lt;/span&gt; --uri viking://resources/volcengine/OpenViking/docs/en
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;Next steps:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Client configuration (&lt;code&gt;ov config&lt;/code&gt;), standalone CLI installs (npm / cargo), and advanced usage such as index rebuilding: &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/getting-started/05-cli-setup&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;CLI setup&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Docker and production deployment: &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/guides/03-deployment&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Deployment guide&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2 id=&#34;use-it-with-your-agent&#34;&gt;Use it with your agent
&lt;/h2&gt;&lt;p&gt;Integrations inject OpenViking recall into your agent&amp;rsquo;s context and auto-commit session memory:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/agent-integrations/02-claude-code&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Claude Code&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/agent-integrations/04-codex&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Codex&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/agent-integrations/03-openclaw&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;OpenClaw&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/agent-integrations/05-hermes&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Hermes&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/agent-integrations/12-cursor&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Cursor&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/agent-integrations/13-trae&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;TRAE / TRAE CN / TraeCode CLI 2.0&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/agent-integrations/10-opencode&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;OpenCode&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/agent-integrations/11-pi&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;pi&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/agent-integrations/15-agent-plugins&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Agent Plugins 1.0&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/agent-integrations/06-mcp-clients&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;MCP clients&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/agent-integrations/07-langchain-langgraph&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;LangChain / LangGraph&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Setup instructions for each agent: &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/agent-integrations/01-overview&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Agent integrations overview&lt;/a&gt;.&lt;/p&gt;
&lt;h2 id=&#34;openviking-helper-beta&#34;&gt;OpenViking Helper (Beta)
&lt;/h2&gt;&lt;p&gt;OpenViking Helper is a desktop console, currently in beta for macOS and Windows x64:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Visual local agent setup&lt;/strong&gt;: detects OpenViking CLI, Claude Code, Codex, Cursor, Trae, and OpenCode, then configures supported plugin, MCP, Hook, and CLI integrations.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Session trace inspection&lt;/strong&gt;: parses Claude Code, Codex, and Trae sessions to show OpenViking recall, prompt injection, MCP calls, capture, and commit events.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Local memory and skill management&lt;/strong&gt;: views local memory / rule files and &lt;code&gt;SKILL.md&lt;/code&gt; skills, then syncs them to OpenViking.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Download:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://lf3-cdn-tos.bytegoofy.com/obj/tron-demo/7654844610543360265/420238785/0.0.19/darwin-arm64/openviking-helper-0.0.19-arm64.dmg&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;macOS Apple Silicon (arm64)&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://lf3-cdn-tos.bytegoofy.com/obj/tron-demo/7654844610543360265/420238785/0.0.19/darwin-x64/openviking-helper-0.0.19-x64.dmg&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;macOS Intel (x64)&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://lf3-cdn-tos.bytegoofy.com/obj/tron-demo/7654844610543360265/420238785/0.0.19/win32-x64/openviking-helper-0.0.19-x64.exe&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Windows (x64)&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h2 id=&#34;vikingbot&#34;&gt;VikingBot
&lt;/h2&gt;&lt;p&gt;VikingBot is an AI agent framework built on top of OpenViking:&lt;/p&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;2
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;3
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-bash&#34; data-lang=&#34;bash&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;pip install &lt;span class=&#34;s2&#34;&gt;&amp;#34;openviking[bot]&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;openviking-server --with-bot
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;ov chat   &lt;span class=&#34;c1&#34;&gt;# in another terminal&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;p&gt;The official Docker image bundles VikingBot and starts it by default alongside the server and console UI. Details: &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/guides/17-vikingbot&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;VikingBot guide&lt;/a&gt;.&lt;/p&gt;
&lt;h2 id=&#34;deploy-in-production&#34;&gt;Deploy in production
&lt;/h2&gt;&lt;p&gt;For production, run OpenViking as a standalone HTTP service — see &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/getting-started/03-quickstart-server&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Server deployment&lt;/a&gt; and the &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/guides/03-deployment&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Deployment guide&lt;/a&gt;.&lt;/p&gt;
&lt;h2 id=&#34;commercial-editions&#34;&gt;Commercial editions
&lt;/h2&gt;&lt;p&gt;&lt;strong&gt;The open-source edition is not crippled.&lt;/strong&gt; OpenViking in this repo is fully open source under AGPLv3: no feature gates, no account required, no activation key. Follow &lt;a class=&#34;link&#34; href=&#34;#deploy-in-production&#34; &gt;Deploy in production&lt;/a&gt; above and run it in production yourself — and that will stay true.&lt;/p&gt;
&lt;p&gt;The two editions below answer &amp;ldquo;who operates it and where it runs&amp;rdquo;, not &amp;ldquo;can I use it&amp;rdquo;.&lt;/p&gt;
&lt;table&gt;
&lt;tr&gt;
&lt;td width=&#34;50%&#34; valign=&#34;top&#34;&gt;
&lt;img src=&#34;docs/images/commercial-saas.png&#34; alt=&#34;Managed SaaS&#34; width=&#34;100%&#34; /&gt;
&lt;h3&gt;☁️ Managed SaaS&lt;/h3&gt;
&lt;p&gt;Officially hosted on &lt;b&gt;Volcano Engine&lt;/b&gt;. Nothing to set up, nothing to operate.&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Personal&lt;/b&gt; — for individual developers. Free trial for up to 50 files, and scales far beyond local hardware with VikingDB.&lt;/li&gt;
&lt;li&gt;&lt;b&gt;Enterprise&lt;/b&gt; — multi-user context management, team collaboration and permissions, enterprise SLA and support.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Existing open-source users can move over with the migration tool.&lt;/p&gt;
&lt;p&gt;&lt;a href=&#34;https://www.volcengine.com/product/openviking-service&#34;&gt;&lt;b&gt;→ Volcano Engine product page&lt;/b&gt;&lt;/a&gt; · &lt;a href=&#34;https://docs.volcengine.com/docs/84313/2374478&#34;&gt;Documentation&lt;/a&gt;&lt;/p&gt;
&lt;p&gt;&lt;sub&gt;Global hosting for regions outside China is coming to &lt;a href=&#34;https://www.byteplus.com&#34;&gt;BytePlus&lt;/a&gt;.&lt;/sub&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td width=&#34;50%&#34; valign=&#34;top&#34;&gt;
&lt;img src=&#34;docs/images/commercial-self-hosted.png&#34; alt=&#34;Self-Managed&#34; width=&#34;100%&#34; /&gt;
&lt;h3&gt;🏢 Self-Managed&lt;/h3&gt;
&lt;p&gt;Runs &lt;b&gt;inside your own environment&lt;/b&gt;. Data never leaves it.&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Online&lt;/b&gt; — deployed into your own cloud account / VPC, BYOC supported, with outbound access for updates and licensing.&lt;/li&gt;
&lt;li&gt;&lt;b&gt;Offline&lt;/b&gt; — fully air-gapped environments with no internet access, for regulated industries.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Adds distributed deployment and official support on top of the open-source edition, activated by license key.&lt;/p&gt;
&lt;p&gt;&lt;a href=&#34;https://docs.google.com/forms/d/e/1FAIpQLScQqwsm7fvKdjtNiW5rWNXJjoHPtedVzLsKSMJgObtsj2_udA/viewform&#34;&gt;&lt;b&gt;→ Talk to us about self-managed deployment&lt;/b&gt;&lt;/a&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;
&lt;blockquote&gt;
&lt;p&gt;Just want to run the open-source edition? Go ahead — you don&amp;rsquo;t need to contact anyone. Head to &lt;a class=&#34;link&#34; href=&#34;#quick-start&#34; &gt;Quick start&lt;/a&gt;.&lt;/p&gt;
&lt;/blockquote&gt;
&lt;h2 id=&#34;research&#34;&gt;Research
&lt;/h2&gt;&lt;p&gt;OpenViking open-sources a subset of the core capabilities described in the VikingMem paper:&lt;/p&gt;
&lt;blockquote&gt;
&lt;p&gt;&lt;strong&gt;VikingMem: A Memory Base Management System for Stateful LLM-based Applications&lt;/strong&gt;
Jiajie Fu, Junwen Chen, Mengzhao Wang, Aoxiang He, Maojia Sheng, Xiangyu Ke, Yifan Zhu, and Yunjun Gao.
arXiv:2605.29640, 2026. Accepted by VLDB 2026.
📄 &lt;a class=&#34;link&#34; href=&#34;https://arxiv.org/abs/2605.29640&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Read the paper on arXiv&lt;/a&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;h2 id=&#34;partner-projects&#34;&gt;Partner Projects
&lt;/h2&gt;&lt;p&gt;OpenViking welcomes collaboration with other open-source projects to build the context data ecosystem. Our confirmed partners include:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/bytedance/deer-flow&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;deer-flow&lt;/a&gt; - Open-source long-horizon SuperAgent harness&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/NoKV-Lab/NoKV&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;NoKV&lt;/a&gt; - AI native distributed file system&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/huangruiteng/loopx&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;loopx&lt;/a&gt; - Lightweight loop engineering state kernel&lt;/li&gt;
&lt;li&gt;&lt;a class=&#34;link&#34; href=&#34;https://github.com/NousResearch/hermes-agent&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Hermes Agent&lt;/a&gt; - The agent that grows with you&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Interested in joining our partner list? Please submit an issue to our community to apply.&lt;/p&gt;
&lt;h2 id=&#34;community--contributing&#34;&gt;Community &amp;amp; contributing
&lt;/h2&gt;&lt;p&gt;OpenViking is still in its early stages, and there is plenty left to build.&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Docs&lt;/strong&gt;: &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;docs.openviking.ai&lt;/a&gt; · &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/faq/faq&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;FAQ&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Blog&lt;/strong&gt;: &lt;a class=&#34;link&#34; href=&#34;https://blog.openviking.ai/&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;blog.openviking.ai&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Team&lt;/strong&gt;: &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/about/01-about-us&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;About us&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Chat&lt;/strong&gt;: 📱 &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/about/01-about-us#lark-group&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;Lark Group&lt;/a&gt; · 💬 &lt;a class=&#34;link&#34; href=&#34;https://docs.openviking.ai/en/about/01-about-us#wechat-group&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
    &gt;WeChat&lt;/a&gt; · 🎮 &lt;a class=&#34;link&#34; href=&#34;https://discord.com/invite/eHvx8E9XF3&#34;  target=&#34;_blank&#34; rel=&#34;noopener&#34;
